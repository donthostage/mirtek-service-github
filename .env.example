# Шаблон справки: файл НЕ загружается автоматически. Задайте переменные в серверном окружении.
MIRTEK_CLASSIFIER=aitunnel
AITUNNEL_API_KEY=
# Точный id выбранной модели с поддержкой structured outputs из каталога AITUNNEL.
AITUNNEL_MODEL=

# Наш сервис сам запрашивает источник. Локальный источник запускается отдельно на 8767.
MIRTEK_SOURCE_BACKEND=http_pull_mock
MIRTEK_SOURCE_URL=http://127.0.0.1:8767
# Не путать с ключом AITUNNEL; для локального мока не нужен.
MIRTEK_SOURCE_API_KEY=
