{
  "openapi": "3.1.0",
  "info": {
    "title": "Миртек: учебный API",
    "description": "Синтетические данные. Baseline или распознавание через AITUNNEL. Без подключения к компании.",
    "version": "0.4.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/messages": {
      "post": {
        "summary": "Messages",
        "operationId": "messages_api_v1_messages_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Message"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reply"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/availability": {
      "post": {
        "summary": "Availability",
        "operationId": "availability_api_v1_availability_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InventoryQuery"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reply"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InventoryQuery": {
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "title": "Sku"
          },
          "warehouse_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "title": "Warehouse Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sku",
          "warehouse_id"
        ],
        "title": "InventoryQuery"
      },
      "Message": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          },
          "context_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "Message"
      },
      "Reply": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "needs_clarification",
              "handoff"
            ],
            "title": "Status"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "reason_code": {
            "type": "string",
            "title": "Reason Code"
          },
          "intent": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "hours",
                  "stock",
                  "promotions",
                  "delivery",
                  "returns",
                  "complaints"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "context_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Id"
          },
          "operator_required": {
            "type": "boolean",
            "title": "Operator Required",
            "default": false
          },
          "handoff_delivered": {
            "type": "boolean",
            "title": "Handoff Delivered",
            "default": false
          },
          "mode": {
            "type": "string",
            "enum": [
              "synthetic_rule_baseline",
              "synthetic_aitunnel"
            ],
            "title": "Mode",
            "default": "synthetic_rule_baseline"
          },
          "evaluated_at": {
            "type": "string",
            "title": "Evaluated At"
          },
          "elapsed_ms": {
            "type": "number",
            "title": "Elapsed Ms",
            "default": 0
          },
          "data_backend": {
            "type": "string",
            "enum": [
              "snapshot",
              "http_pull_mock"
            ],
            "title": "Data Backend",
            "default": "snapshot"
          },
          "handoff_payload": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Handoff Payload"
          },
          "recognizer_version": {
            "type": "string",
            "title": "Recognizer Version",
            "default": "lexical-1"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "status",
          "answer",
          "reason_code",
          "evaluated_at"
        ],
        "title": "Reply"
      },
      "Source": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "as_of": {
            "type": "string",
            "title": "As Of"
          },
          "valid_until": {
            "type": "string",
            "title": "Valid Until"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "version",
          "as_of",
          "valid_until"
        ],
        "title": "Source"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}